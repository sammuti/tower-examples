[app]
name = "db-analyst"
script = "./app.py"

schedule = '0 */2 * * * *'

[[parameters]]
name = "user_question"
description = "Natural language question about the database that you want answered. Leave empty to check Slack inbox for @mentions (inbox mode)."
default = ""

[[parameters]]
name = "schema_context"
description = "Optional schema context to help the LLM understand the database structure (table names, column descriptions, relationships, etc.)"
default = ""

[[parameters]]
name = "model_to_use"
description = "Name and version of the model to use for analysis. E.g. deepseek-r1:14b when using ollama or deepseek-ai/DeepSeek-R1 when using Together.ai"
default = "Qwen/Qwen3-Coder-30B-A3B-Instruct"

[[parameters]]
name = "max_tokens"
description = "The maximum length of output, measured in tokens"
default = "2000"

[[parameters]]
name = "max_iterations"
description = "Maximum number of agent iterations for tool calling loop"
default = "10"

[[parameters]]
name = "slack_channel"
description = "Slack channel ID to post results to (e.g., C01234567). Leave empty to disable Slack integration."
default = ""

[[parameters]]
name = "slack_thread_ts"
description = "Slack thread timestamp to reply to. Leave empty to start new thread."
default = ""

